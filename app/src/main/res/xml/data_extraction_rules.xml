<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and phone-to-phone transfer on Android 12+ (SPEC §9): the database and settings. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
